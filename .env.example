L# ── AWS Academy ─────────────────────────────────────────────────────────────
# AMI base preconfigurada con MonitorC instalado y systemd habilitado
AMI_ID=ami-XXXXXXXX

# Subnet donde se lanzarán las nuevas AppInstances
SUBNET_ID=subnet-XXXXXXXX

# Security Group que aplica a las AppInstances
SECURITY_GROUP_ID=sg-XXXXXXXX

# ARN del Target Group del ALB donde se registran/desregistran instancias
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:us-east-1:ACCOUNT_ID:targetgroup/NOMBRE/ID

# IP privada de la instancia central (MonitorS/ControllerASG)
# En AWS se detecta automáticamente; solo necesario para pruebas locales
MONITOR_S_IP=10.0.0.1

# ── SSH ──────────────────────────────────────────────────────────────────────
KEY_NAME=vockey

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
